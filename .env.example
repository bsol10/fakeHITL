# Copy to .env and fill in. .env is gitignored; never commit a real key.
#   cp .env.example .env

# Which model provider evidence extraction uses: anthropic or gemini.
# Unset means anthropic. Gemini becomes the default only once its live tests
# (uv run pytest -m live) have passed against a real key.
UPDATER_MODEL_PROVIDER=anthropic

# --- anthropic ---------------------------------------------------------------
# Anthropic API key, used by the evidence-extraction and comparison stages.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model for evidence extraction and claim classification. These stages are
# accuracy-critical and low-volume — do not downgrade this to save cost without
# re-running the citation-fidelity evaluation (BUILD_SPEC.md section 6).
# Required: the code has no default model id.
ANTHROPIC_MODEL=claude-opus-5

# --- gemini (uv sync --extra gemini) ----------------------------------------
# Gemini API key. GOOGLE_API_KEY is also accepted, which is what the group's
# src/backend/query.py sets; if both are set, GEMINI_API_KEY wins.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required, and deliberately without a default. The group code names
# gemini-3.5-flash, which has not been checked against the API's model list.
# Put a model your key can call here; the live tests check it is listed.
GEMINI_MODEL=

# Local SQLite database holding passages, embeddings, snapshots and review
# decisions. Relative paths resolve against the repository root.
UPDATER_DB_PATH=data/updater.sqlite3
