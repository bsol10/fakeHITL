# Secrets — .env.example is the committed template, .env never is.
.env

# Local artefacts: SQLite index, source snapshots, generated drafts.
# data/sources/ is where documents to ingest go. The directory is committed
# (via its README) so a fresh clone has somewhere obvious to put them; the
# documents themselves are client material and stay out of the repo.
#
# `data/*`, not `data/`: git never descends into an excluded directory, so a
# later `!` line cannot re-include anything beneath one. Excluding the contents
# instead leaves the directory walkable. Do not collapse these four lines.
data/*
!data/sources/
data/sources/*
!data/sources/README.md
# The group repo's own data/readme.md predates this file.
!data/readme.md
drafts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# uv.lock is committed on purpose — it is the reproducible pin.

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
